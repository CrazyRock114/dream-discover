# ============================================
# 梦境录 —— 服务端环境变量（Express / Railway）
#
# 复制为 server/.env 后填写。
# 本地启动：`pnpm dev:server`（工作目录是 server/，dotenv 会自动读取 server/.env）
# 生产环境：在 Railway 的 Variables 里配置同名变量，不要放 .env 文件
# ============================================

# ── 基础 ──
# 本地默认 9091；Railway 会自动注入 PORT，无需手动设置
PORT=9091

# ── 数据库（必填）─────────────────────────────
# Supabase Postgres 直连串。
# 注意：Supabase 的 PgBouncer（端口 6543）需要 prepare:false，代码已自动处理。
# Railway 不支持 IPv6 出站，代码会主动解析 IPv4 并用 host 覆盖（不改 URL，保留 SSL 校验）
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── LLM（必填）─────────────────────────────────
# 通用 OpenAI 兼容接口（火山引擎 / DeepSeek / 任何兼容网关）
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 兼容写法：只配 DEEPSEEK_API_KEY 也行，会走下面的 base url
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 语音识别 ASR（必填）────────────────────────
# 火山引擎豆包语音 · 大模型录音文件识别极速版
VOLCENGINE_API_KEY=your_volcengine_api_key
# 资源 ID，默认值即为极速版，一般不用改
VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo

# ── 邮件（登录验证码，必填）───────────────────
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=noreply@dreamdiscover.top

# ── Supabase Auth（创建登录用户时需要）──────────
# 服务端用它调 auth.admin.listUsers / createUser
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Cloudflare R2（音频存档，可选）─────────────
# 4/20 起语音走直传转录，这条链路已经用不到；
# 保留是为了将来做音频存档，删掉也不影响现有功能
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_URL=https://your-custom-domain.com
