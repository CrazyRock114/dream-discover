# ============================================
# 梦境录 —— 前端环境变量（Expo / Vercel）
#
# 复制为 client/.env 后填写。
# 本地启动：`pnpm dev:client`（工作目录是 client/，Expo 会自动读取 client/.env）
# 生产环境：在 Vercel 的 Environment Variables 里配置同名变量
# ============================================

# ── 后端 API 地址（必填）───────────────────────
# 本地：EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9091
# 生产：EXPO_PUBLIC_BACKEND_BASE_URL=https://your-railway-app.up.railway.app
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9091

# ── 通用接口基址（可选）────────────────────────
# client/utils/index.ts 里的 createFormDataFile 等工具会用到
EXPO_PUBLIC_API_BASE=

# ── 应用标识 ──────────────────────────────────
# APP_NAME 决定应用显示名，默认「梦境录」
APP_NAME=梦境录
# APP_ID / EXPO_PUBLIC_APP_ID 用于生成 Expo slug 与原生包名
# APP_ID=your_app_id
